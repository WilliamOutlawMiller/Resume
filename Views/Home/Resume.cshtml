@{
    ViewData["Title"] = "Resume - William Miller";
}

<section class="resume-section">
    <div class="container">
        <div class="resume-header">
            <h1>Resume</h1>
            <a href="@Url.Action("DownloadResume")" class="btn btn-download">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                    <polyline points="7 10 12 15 17 10"></polyline>
                    <line x1="12" y1="15" x2="12" y2="3"></line>
                </svg>
                Download Resume
            </a>
        </div>
        <div class="resume-content">
            @Html.Raw(ViewBag.ResumeHtml)
        </div>
    </div>
</section>

@section Scripts {
    <style>
        .resume-section {
            padding: 4rem 0;
            min-height: 80vh;
        }

        .resume-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 3rem;
            flex-wrap: wrap;
            gap: 1rem;
        }

        .resume-header h1 {
            font-size: 2.5rem;
            color: var(--text-color);
        }

        .btn-download {
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
            padding: 0.75rem 2rem;
            background-color: var(--primary-color);
            color: var(--bg-color);
            text-decoration: none;
            border-radius: 8px;
            font-weight: 500;
            transition: all 0.3s;
        }

        .btn-download:hover {
            background-color: var(--secondary-color);
            transform: translateY(-2px);
            box-shadow: var(--shadow-lg);
        }

        .resume-content {
            background-color: var(--bg-color);
            padding: 3rem;
            border-radius: 12px;
            box-shadow: var(--shadow-lg);
            max-width: 900px;
            margin: 0 auto;
        }

        .resume-content h1,
        .resume-content h2,
        .resume-content h3 {
            color: var(--text-color);
            margin-top: 2rem;
            margin-bottom: 1rem;
        }

        .resume-content h1 {
            font-size: 2rem;
            border-bottom: 3px solid var(--primary-color);
            padding-bottom: 0.5rem;
        }

        .resume-content h2 {
            font-size: 1.5rem;
            color: var(--primary-color);
        }

        .resume-content h3 {
            font-size: 1.25rem;
        }

        .resume-content ul {
            margin-left: 1.5rem;
            margin-bottom: 1rem;
        }

        .resume-content li {
            margin-bottom: 0.5rem;
            line-height: 1.6;
        }

        .resume-content p {
            margin-bottom: 1rem;
            line-height: 1.8;
        }

        .resume-content strong {
            color: var(--text-color);
            font-weight: 600;
        }

        @@media (max-width: 768px) {
            .resume-content {
                padding: 1.5rem;
            }

            .resume-header {
                flex-direction: column;
                align-items: flex-start;
            }
        }
    </style>
}

