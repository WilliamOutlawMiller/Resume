@inject WilliamMillerSite.Services.ResumeService ResumeService
@{
    ViewData["Title"] = "Resume - William Miller";
    var resumeData = ViewBag.ResumeData as WilliamMillerSite.Services.ResumeData ?? new WilliamMillerSite.Services.ResumeData();
}

<section class="resume-section">
    <div class="container">
        <div class="resume-hero">
            <div class="resume-hero-content">
                <h2 class="resume-name">WILLIAM MILLER</h2>
                <p class="resume-contact">Nashville, TN • (615) 630-1806 • williamoutlawmiller@gmail.com</p>
                <div class="resume-social">
                    <a href="https://www.linkedin.com/in/william-miller-b31829214/" target="_blank" class="social-icon">
                        <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
                            <path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/>
                        </svg>
                    </a>
                    <a href="https://github.com/WilliamOutlawMiller" target="_blank" class="social-icon">
                        <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
                            <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
                        </svg>
                    </a>
                    <a href="@Url.Action("DownloadResume", "Home")" class="btn btn-download">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                            <polyline points="7 10 12 15 17 10"></polyline>
                            <line x1="12" y1="15" x2="12" y2="3"></line>
                        </svg>
                        Download Resume
                    </a>
                </div>
            </div>
        </div>

        @if (!string.IsNullOrEmpty(resumeData.Summary))
        {
            <div class="resume-summary">
                <h3 class="section-label">Professional Summary</h3>
                <div class="resume-summary-content">
                    <p class="summary-text">@resumeData.Summary</p>
                </div>
            </div>
        }

        @if (resumeData.Experiences.Any())
        {
            <div class="resume-experience">
                <h3 class="section-label">Professional Experience</h3>
                <div class="timeline">
                    @foreach (var exp in resumeData.Experiences)
                    {
                        <div class="timeline-item" id="@ResumeService.GetCompanySlug(exp.Company)" data-company="@exp.Company.ToLower().Replace(" ", "-")">
                            <div class="timeline-marker"></div>
                            <div class="timeline-content">
                                <div class="experience-header">
                                    <h4 class="company-name">@exp.Company</h4>
                                </div>
                                <div class="experience-meta">
                                    <span class="role">@exp.Role</span>
                                    @if (!string.IsNullOrEmpty(exp.Location))
                                    {
                                        <span class="meta-separator">•</span>
                                        <span class="location">@exp.Location</span>
                                    }
                                    @if (!string.IsNullOrEmpty(exp.Duration))
                                    {
                                        <span class="meta-separator">•</span>
                                        <span class="experience-duration">@exp.Duration</span>
                                    }
                                </div>
                                <div class="experience-description">
                                    @foreach (var paragraph in exp.BulletPoints)
                                    {
                                        <p class="narrative-paragraph">@paragraph</p>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        }

        @if (resumeData.Projects.Any())
        {
            <div class="resume-projects">
                <h3 class="section-label">Projects</h3>
                <div class="project-carousel-container">
                    <div class="carousel-controls">
                        <button class="carousel-btn carousel-btn-prev" aria-label="Previous project">
                            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <polyline points="15 18 9 12 15 6"></polyline>
                            </svg>
                        </button>
                        <div class="carousel-indicators">
                            @for (int i = 0; i < resumeData.Projects.Count; i++)
                            {
                                <button class="carousel-indicator" data-slide-index="@i" aria-label="Go to project @(i + 1)"></button>
                            }
                        </div>
                        <button class="carousel-btn carousel-btn-next" aria-label="Next project">
                            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <polyline points="9 18 15 12 9 6"></polyline>
                            </svg>
                        </button>
                    </div>
                    <div class="project-carousel" id="projectCarousel">
                        @for (int i = 0; i < resumeData.Projects.Count; i++)
                        {
                            var project = resumeData.Projects[i];
                            <div class="project-slide" id="project-@project.Title.ToLower().Replace(" ", "-")" data-slide-index="@i" data-type="@project.Type">
                                <div class="project-slide-content">
                                    <div class="project-slide-header">
                                        <h4 class="project-slide-title">@project.Title</h4>
                                        <span class="project-slide-badge" data-type="@project.Type">@project.Type</span>
                                    </div>
                                    @if (!string.IsNullOrEmpty(project.Duration))
                                    {
                                        <p class="project-slide-meta">@project.Duration</p>
                                    }
                                    <div class="project-slide-description">
                                        @foreach (var paragraph in project.BulletPoints)
                                        {
                                            <p class="project-slide-paragraph">@paragraph</p>
                                        }
                                    </div>
                                    @if (project.Technologies != null && project.Technologies.Any())
                                    {
                                        <div class="project-tech">
                                            @foreach (var tech in project.Technologies)
                                            {
                                                <span class="tech-badge">@tech</span>
                                            }
                                        </div>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        }

        <div class="resume-skills">
            <h3 class="section-label">Technical Skills</h3>
            <div class="resume-skills-content">
                <div class="skills-display" id="skillsContainer">
                    @Html.Raw(ViewBag.SkillsHtml ?? ViewBag.ResumeHtml)
                </div>
            </div>
        </div>

    </div>
</section>

<div class="particles-background" id="particles"></div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            if (window.location.hash) {
                const hash = window.location.hash.substring(1);
                const companyElement = document.getElementById(hash);
                if (companyElement && !hash.startsWith('project-')) {
                    window.scrollTo(0, 0);
                }
            }
            
            const carousel = document.getElementById('projectCarousel');
            if (!carousel) return;
            
            const slides = carousel.querySelectorAll('.project-slide');
            const indicators = document.querySelectorAll('.carousel-indicator');
            const prevBtn = document.querySelector('.carousel-btn-prev');
            const nextBtn = document.querySelector('.carousel-btn-next');
            
            let currentSlide = 0;
            
            function showSlide(index) {
                slides.forEach((slide, i) => {
                    slide.classList.toggle('active', i === index);
                });
                
                indicators.forEach((indicator, i) => {
                    indicator.classList.toggle('active', i === index);
                });
                
                currentSlide = index;
                updateURL();
            }
            
            function updateURL() {
                const activeSlide = slides[currentSlide];
                const currentHash = window.location.hash.substring(1);
                if (activeSlide && currentHash && currentHash.startsWith('project-')) {
                    const projectId = activeSlide.id;
                    const newUrl = window.location.pathname + '#' + projectId;
                    window.history.replaceState(null, '', newUrl);
                }
            }
            
            function goToSlide(index) {
                if (index < 0) {
                    index = slides.length - 1;
                } else if (index >= slides.length) {
                    index = 0;
                }
                showSlide(index);
                const activeSlide = slides[index];
                if (activeSlide) {
                    const projectId = activeSlide.id;
                    const newUrl = window.location.pathname + '#' + projectId;
                    window.history.replaceState(null, '', newUrl);
                }
            }
            
            function goToProjectByHash() {
                const hash = window.location.hash.substring(1);
                if (hash) {
                    const targetSlide = carousel.querySelector('#' + hash);
                    if (targetSlide) {
                        const slideIndex = parseInt(targetSlide.getAttribute('data-slide-index'));
                        if (!isNaN(slideIndex)) {
                            showSlide(slideIndex);
                            setTimeout(() => {
                                targetSlide.scrollIntoView({ behavior: 'smooth', block: 'center' });
                            }, 100);
                            return;
                        }
                    }
                    const companyElement = document.getElementById(hash);
                    if (companyElement) {
                        if (slides.length > 0) {
                            slides.forEach((slide, i) => {
                                slide.classList.toggle('active', i === 0);
                            });
                            indicators.forEach((indicator, i) => {
                                indicator.classList.toggle('active', i === 0);
                            });
                            currentSlide = 0;
                        }
                        setTimeout(() => {
                            const offset = companyElement.getBoundingClientRect().top + window.pageYOffset - 100;
                            window.scrollTo({ top: offset, behavior: 'smooth' });
                        }, 100);
                        return;
                    }
                }
                if (slides.length > 0) {
                    showSlide(0);
                }
            }
            
            prevBtn.addEventListener('click', () => goToSlide(currentSlide - 1));
            nextBtn.addEventListener('click', () => goToSlide(currentSlide + 1));
            
            indicators.forEach((indicator, index) => {
                indicator.addEventListener('click', () => showSlide(index));
            });
            
            document.addEventListener('keydown', (e) => {
                if (e.key === 'ArrowLeft') {
                    goToSlide(currentSlide - 1);
                } else if (e.key === 'ArrowRight') {
                    goToSlide(currentSlide + 1);
                }
            });
            
            window.addEventListener('hashchange', goToProjectByHash);
            
            goToProjectByHash();
        });
    </script>
}
