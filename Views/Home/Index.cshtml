@model WilliamMillerSite.Services.ResumeData?
@inject WilliamMillerSite.Services.ResumeService ResumeService
@{
    ViewData["Title"] = "William Miller - Full-Stack Developer";
    var resumeData = Model ?? new WilliamMillerSite.Services.ResumeData();
}

<section class="hero">
    <div class="color-layers">
        <div class="color-layer color-layer-blue"></div>
        <div class="color-layer color-layer-light-pink"></div>
        <div class="divider-line"></div>
    </div>
    <div class="container">
        <div class="hero-content">
            <div class="headshot-container">
                <img src="@Url.Content("~/images/headshot.jpg")" 
                     alt="William Miller" class="headshot" id="headshot-img" />
            </div>
            <div class="hero-text">
                <h1>William Miller</h1>
                <p class="subtitle" id="typing-subtitle">Full-Stack Software Engineer</p>
                <p class="location">Nashville, TN</p>
                <div class="hero-actions">
                    <a href="/Resume" class="btn btn-primary">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                            <polyline points="14 2 14 8 20 8"></polyline>
                            <line x1="16" y1="13" x2="8" y2="13"></line>
                            <line x1="16" y1="17" x2="8" y2="17"></line>
                            <polyline points="10 9 9 9 8 9"></polyline>
                        </svg>
                        View Resume
                    </a>
                    <a href="/Resume/Download" class="btn btn-secondary">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                            <polyline points="7 10 12 15 17 10"></polyline>
                            <line x1="12" y1="15" x2="12" y2="3"></line>
                        </svg>
                        Download Resume
                    </a>
                </div>
                <div class="social-links">
                    <a href="https://github.com/WilliamOutlawMiller" target="_blank" rel="noopener noreferrer" class="social-link">
                        <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
                            <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
                        </svg>
                        GitHub
                    </a>
                    <a href="https://www.linkedin.com/in/william-miller-b31829214/" target="_blank" rel="noopener noreferrer" class="social-link">
                        <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
                            <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
                        </svg>
                        LinkedIn
                    </a>
                    <a href="mailto:williamoutlawmiller@gmail.com" class="social-link">
                        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/>
                            <polyline points="22,6 12,13 2,6"/>
                        </svg>
                        Email
                    </a>
                </div>
            </div>
        </div>
    </div>
</section>


<section id="about" class="section">
    <div class="container">
        <h2 class="section-title">About</h2>
        <div class="about-content-box">
            <div class="about-content">
            @if (!string.IsNullOrEmpty(resumeData.Summary))
            {
                <p>@resumeData.Summary</p>
            }
            else
            {
                <p>
                    Full-stack Software Engineer with 2+ years of experience at AllianceBernstein delivering enterprise-scale solutions 
                    for Fixed Income municipal bond trading systems. Demonstrated expertise in designing, developing, and deploying 
                    mission-critical financial applications using Python, C#, and Angular.
                </p>
                <p>
                    Experience in building robust APIs, implementing complex business logic, modernizing legacy systems, and establishing 
                    CI/CD pipelines. Proven ability to independently manage multiple high-impact projects while maintaining production 
                    systems serving traders and portfolio managers.
                </p>
            }
            </div>
        </div>
    </div>
</section>

<section id="experience" class="section section-alt">
    <div class="container">
        <h2 class="section-title">Work Experience</h2>
        <div class="experience-container">
            <div class="experience-header">
                <a href="https://www.linkedin.com/in/william-miller-b31829214/details/experience/" target="_blank" rel="noopener noreferrer" class="linkedin-link">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
                        <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
                    </svg>
                    <span>View on LinkedIn</span>
                </a>
                <a href="/Resume" class="btn btn-outline">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                        <polyline points="14 2 14 8 20 8"></polyline>
                        <line x1="16" y1="13" x2="8" y2="13"></line>
                        <line x1="16" y1="17" x2="8" y2="17"></line>
                        <polyline points="10 9 9 9 8 9"></polyline>
                    </svg>
                    View Full Resume
                </a>
            </div>
            <div class="experience-list">
                @foreach (var exp in resumeData.Experiences)
                {
                    <div class="experience-item" data-company="@exp.Company">
                        <div class="experience-item-content">
                            <div class="experience-main">
                                <h3 class="experience-company">@exp.Company</h3>
                                <p class="experience-role">@exp.Role</p>
                                <p class="experience-duration">@exp.Duration</p>
                            </div>
                            <div class="experience-hover-indicator">
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <path d="M5 12h14M12 5l7 7-7 7"/>
                                </svg>
                            </div>
                        </div>
                        <a href="/Resume#@ResumeService.GetCompanySlug(exp.Company)" class="experience-link" aria-label="View full details for @exp.Company"></a>
                    </div>
                }
            </div>
            <div class="experience-footer">
                <a href="/Resume" class="btn btn-outline">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                        <polyline points="14 2 14 8 20 8"></polyline>
                        <line x1="16" y1="13" x2="8" y2="13"></line>
                        <line x1="16" y1="17" x2="8" y2="17"></line>
                        <polyline points="10 9 9 9 8 9"></polyline>
                    </svg>
                    View Full Resume
                </a>
            </div>
        </div>
    </div>
</section>

<section id="projects" class="section">
    <div class="container">
        <h2 class="section-title">Projects</h2>
        <p class="section-subtitle">A collection of my work across professional, personal, and open-source projects</p>
        
        <div class="projects-showcase">
            @foreach (var project in resumeData.Projects)
            {
                <a href="/Resume#project-@project.Title.ToLower().Replace(" ", "-")" class="project-showcase-card" data-type="@project.Type">
                    <div class="project-showcase-content">
                        <div class="project-showcase-header">
                            <h4 class="project-showcase-title">@project.Title</h4>
                            <span class="project-type-badge" data-type="@project.Type">@project.Type</span>
                        </div>
                        @if (!string.IsNullOrEmpty(project.Duration))
                        {
                            <p class="project-showcase-meta">@project.Duration</p>
                        }
                        @if (project.BulletPoints.Any())
                        {
                            <p class="project-showcase-preview">@project.BulletPoints.First().Substring(0, Math.Min(120, project.BulletPoints.First().Length))@(project.BulletPoints.First().Length > 120 ? "..." : "")</p>
                        }
                    </div>
                </a>
            }
        </div>
    </div>
</section>

<section id="skills" class="section section-alt">
    <div class="container">
        <h2 class="section-title">Technical Skills</h2>
        <div class="skills-visualization">
            <div class="skill-category-card">
                <h3>Core Technologies</h3>
                <div class="skill-bars">
                    <div class="skill-bar" data-skill="C#" data-years="3">
                        <div class="skill-label">
                            <span>C#</span>
                            <span class="skill-years">3 years</span>
                        </div>
                        <div class="skill-progress"><div class="skill-fill" style="width: 100%;"></div></div>
                    </div>
                    <div class="skill-bar" data-skill="Python" data-years="2">
                        <div class="skill-label">
                            <span>Python</span>
                            <span class="skill-years">2 years</span>
                        </div>
                        <div class="skill-progress"><div class="skill-fill" style="width: 66.67%;"></div></div>
                    </div>
                    <div class="skill-bar" data-skill="Angular" data-years="2">
                        <div class="skill-label">
                            <span>Angular</span>
                            <span class="skill-years">2 years</span>
                        </div>
                        <div class="skill-progress"><div class="skill-fill" style="width: 66.67%;"></div></div>
                    </div>
                    <div class="skill-bar" data-skill="SQL" data-years="3">
                        <div class="skill-label">
                            <span>SQL</span>
                            <span class="skill-years">3 years</span>
                        </div>
                        <div class="skill-progress"><div class="skill-fill" style="width: 100%;"></div></div>
                    </div>
                    <div class="skill-bar" data-skill="DevOps" data-years="1">
                        <div class="skill-label">
                            <span>DevOps</span>
                            <span class="skill-years">1 year</span>
                        </div>
                        <div class="skill-progress"><div class="skill-fill" style="width: 33.33%;"></div></div>
                    </div>
                </div>
            </div>
            <div class="skill-category-card">
                <h3>Frameworks & Libraries</h3>
                <div class="skills-grid-compact">
                    <span class="skill-tag">.NET Core / .NET 8</span>
                    <span class="skill-tag">Angular</span>
                    <span class="skill-tag">Flask</span>
                    <span class="skill-tag">FastAPI</span>
                    <span class="skill-tag">Entity Framework</span>
                    <span class="skill-tag">SignalR</span>
                </div>
            </div>
            <div class="skill-category-card">
                <h3>DevOps & Infrastructure</h3>
                <div class="skills-grid-compact">
                    <span class="skill-tag">Docker</span>
                    <span class="skill-tag">Kubernetes</span>
                    <span class="skill-tag">Azure DevOps</span>
                    <span class="skill-tag">GitHub Actions</span>
                    <span class="skill-tag">CI/CD Pipelines</span>
                    <span class="skill-tag">NGINX</span>
                </div>
            </div>
            <div class="skill-category-card">
                <h3>Specializations</h3>
                <div class="skills-grid-compact">
                    <span class="skill-tag">API Design & Architecture</span>
                    <span class="skill-tag">Multithreading & Concurrency</span>
                    <span class="skill-tag">OAuth 2.0 & SSO</span>
                    <span class="skill-tag">ETL Pipelines</span>
                    <span class="skill-tag">LLM Integration</span>
                    <span class="skill-tag">REST APIs</span>
                </div>
            </div>
        </div>
    </div>
</section>

